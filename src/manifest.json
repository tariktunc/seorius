{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "short_name": "Seorius",
  "description": "__MSG_appDesc__",
  "version": "1.0.0",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_appName__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
